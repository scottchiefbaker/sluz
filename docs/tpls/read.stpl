<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sluz v{$sluz_version} documentation</title>
    <meta name="description" content="Sluz v{$sluz_version} — Simple PHP templating engine documentation">
    <link rel="icon" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><text y="14" font-size="14">◈</text></svg>'>

    <link href="css/bootstrap.min.css" rel="stylesheet">
    <script>{literal}try{var k='sluz-theme';var t=localStorage.getItem(k)||'dark';document.documentElement.setAttribute('data-bs-theme',t);}catch(e){document.documentElement.setAttribute('data-bs-theme','dark');}{/literal}</script>

	{literal}
	<style>
		:root { --sluz-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace; }
		body { -webkit-font-smoothing: antialiased; }
		.navbar-brand { letter-spacing: .02em; font-weight: 700; }

		/* code panes */
		.php_file, .tpl_file { font-family: var(--sluz-mono); font-size: .875rem; line-height: 1.5; }
		.php_file { padding: 0; overflow-x: auto; }
		.php_file pre, .php_file code { margin: 0; background: transparent !important; }
		.php_file pre { padding: .85rem 1rem; }
		.tpl_file pre { font-family: var(--sluz-mono); font-size: .875rem; line-height: 1.5; padding: .85rem 1rem; overflow-x: auto; background: transparent; }
		.card { box-shadow: 0 1px 2px rgba(0,0,0,.06); }
		.card-header { font-size: .85rem; letter-spacing: .01em; }

		/* highlight_string inline colors — light theme (defaults) */
		[data-bs-theme="light"] .php_file span[style*="#0000BB"] { color: #0000BB !important; }
		[data-bs-theme="light"] .php_file span[style*="#007700"] { color: #007700 !important; }
		[data-bs-theme="light"] .php_file span[style*="#DD0000"] { color: #c9211e !important; }
		[data-bs-theme="light"] .php_file span[style*="#FF8000"] { color: #a85a00 !important; }
		[data-bs-theme="light"] .php_file span[style*="#000000"] { color: #000000 !important; }

		/* dark theme — softer, higher-contrast palette */
		[data-bs-theme="dark"] .php_file { background: #1a1d20; }
		[data-bs-theme="dark"] .php_file span[style*="#0000BB"] { color: #82aaff !important; }
		[data-bs-theme="dark"] .php_file span[style*="#007700"] { color: #7ec8a2 !important; }
		[data-bs-theme="dark"] .php_file span[style*="#DD0000"] { color: #ff869a !important; }
		[data-bs-theme="dark"] .php_file span[style*="#FF8000"] { color: #ffcb6b !important; }
		[data-bs-theme="dark"] .php_file span[style*="#000000"] { color: #e6edf3 !important; }
		[data-bs-theme="dark"] .php_file code[style*="#000000"] { color: #e6edf3 !important; }
		[data-bs-theme="dark"] .tpl_file { background: #1a1d20; color: #e6edf3; }
		[data-bs-theme="light"] .tpl_file { background: #f8f9fa; }

		#doc-nav .list-group-item.active { font-weight: 600; }
		.output-frame { background: var(--bs-body-bg); }
		.output-frame-card { background: var(--bs-body-bg); }
		iframe.output-frame { color-scheme: light; background: #fff; }
		[data-bs-theme="dark"] iframe.output-frame { color-scheme: dark; background: #16181d; }
		[data-bs-theme="light"] iframe.output-frame { color-scheme: light; background: #fff; }
	</style>
	{/literal}
  </head>

<body>
	<nav class="navbar sticky-top bg-body-tertiary border-bottom shadow-sm">
		<div class="container-lg d-flex align-items-center justify-content-between">
			<div class="d-flex align-items-center gap-3">
				<a href="../" class="btn btn-outline-secondary btn-sm" title="Back to project" aria-label="Home">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
						<path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.707 1.5ZM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5 5 5Z"/>
					</svg>
				</a>
				<span class="navbar-brand mb-0 h1">Sluz <span class="badge text-bg-secondary align-middle fw-normal" style="font-size:.55em; letter-spacing:.04em;">v{$sluz_version}</span></span>
				<span class="text-body-secondary small d-none d-md-inline">Simple PHP templating engine</span>
			</div>
			<div class="d-flex align-items-center gap-2">
				<button data-theme-toggle class="btn btn-outline-secondary btn-sm" type="button" aria-label="Toggle theme" title="Toggle theme" style="width: 3em;"><span data-theme-icon aria-hidden="true">☾</span></button>
				<a href="sandbox/" class="btn btn-outline-secondary btn-sm d-none d-sm-inline" title="Test out Sluz syntax in our sandbox">Sandbox</a>
				<a href="https://github.com/scottchiefbaker/sluz" title="Official GitHub project" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm d-none d-sm-inline">GitHub</a>
				<a href="https://www.sluz.org" target="_blank" rel="noopener" title="Project homepage" class="btn btn-outline-secondary btn-sm d-none d-sm-inline">Sluz.org</a>
			</div>
		</div>
	</nav>

	<div class="container-lg mt-4 mb-4">
		<div class="row g-4">
			<aside class="col-lg-3">
				<div class="card">
					<div class="card-header fw-semibold d-flex align-items-center justify-content-between">
						<span>Documentation</span>
						<span class="badge text-bg-secondary fw-normal">{$doc_name}</span>
					</div>
					<div class="list-group list-group-flush" id="doc-nav">
						{foreach $doc_files as $file}
						<a href="?doc={$file.id}" class="list-group-item list-group-item-action {if $file.id == $doc_current}active{/if}" title="{$file.id}">{$file.label}</a>
						{/foreach}
					</div>
				</div>
				<div class="d-none d-lg-block text-body-secondary small mt-3 px-1">
					Select an example to view its PHP, template, and live output.
				</div>
			</aside>

			<main class="col-lg-9">
				<div class="d-flex align-items-baseline justify-content-between mb-3">
					<h4 class="mb-0">{$doc_name}</h4>
					<a href="{$doc_name}" target="_blank" class="small link-secondary">open standalone ↗</a>
				</div>

				<div class="card mb-3">
					<div class="card-header fw-semibold d-flex align-items-center gap-2">
						<span class="badge text-bg-primary">PHP</span> Source
					</div>
					<div class="card-body p-0">
						<div class="php_file">{$php_contents}</div>
					</div>
				</div>

				{if $tpl_contents}
				<div class="card mb-3">
					<div class="card-header fw-semibold d-flex align-items-center gap-2">
						<span class="badge text-bg-success">TPL</span> Template
					</div>
					<div class="card-body p-0">
						<div class="tpl_file"><pre class="m-0">{$tpl_contents}</pre></div>
					</div>
				</div>
				{/if}

				<div class="card mb-3">
					<div class="card-header fw-semibold d-flex align-items-center justify-content-between">
						<span class="d-flex align-items-center gap-2"><span class="badge text-bg-warning">OUT</span> Live output</span>
						<span class="text-body-secondary fw-normal small">iframe preview</span>
					</div>
					<div class="card-body p-0 overflow-hidden rounded-bottom output-frame-card">
						<iframe class="output-frame" style="border:0; width:100%; height:22em; display:block;" src="{$doc_name}" loading="lazy" title="Output preview for {$doc_name}"></iframe>
					</div>
				</div>
			</main>
		</div>

		<footer class="text-center text-body-secondary small mt-5 pt-3 border-top">
			Sluz v{$sluz_version} — <a href="https://github.com/scottchiefbaker/sluz" class="link-secondary" target="_blank" rel="noopener">GitHub</a> · <a href="sandbox/" class="link-secondary">Sandbox</a> · <a href="https://www.sluz.org" class="link-secondary" target="_blank" rel="noopener">Sluz.org</a>
		</footer>
	</div>

	<script src="js/theme.js"></script>
</body>
</html>
